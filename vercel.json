{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/collections", "destination": "/", "permanent": true },
    { "source": "/collections/:path*", "destination": "/", "permanent": true },
    { "source": "/submit-profile", "destination": "/", "permanent": true },
    { "source": "/submit-profile/:path*", "destination": "/", "permanent": true },
    { "source": "/speech-tech-conferences-2026", "destination": "/blog/speech-tech-conferences-2026", "permanent": true },
    { "source": "/speech-tech-conferences-2026.html", "destination": "/blog/speech-tech-conferences-2026", "permanent": true },
    { "source": "/asr-benchmarks-2026", "destination": "/blog/asr-benchmarks-2026", "permanent": true },
    { "source": "/asr-benchmarks-2026.html", "destination": "/blog/asr-benchmarks-2026", "permanent": true },
    { "source": "/remote-speech-recognition-jobs", "destination": "/blog/remote-speech-recognition-jobs-2026", "permanent": true },
    { "source": "/remote-speech-recognition-jobs-2026", "destination": "/blog/remote-speech-recognition-jobs-2026", "permanent": true },
    { "source": "/remote-speech-recognition-jobs-2026.html", "destination": "/blog/remote-speech-recognition-jobs-2026", "permanent": true },
    { "source": "/jobs/:path*", "destination": "/jobs", "permanent": true },
    { "source": "/senior-asr-engineer-whisper-remote", "destination": "/whisper-jobs", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
